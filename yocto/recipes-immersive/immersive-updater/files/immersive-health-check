#!/usr/bin/env python3
"""Check the local role's API and renderer capability before confirming an OTA."""
import base64
import json
from pathlib import Path
import socket
import sys
import urllib.request


def healthy(role, status, hardware_decoder=True, expected_version=None):
    if expected_version is not None and status.get('version') != expected_version:
        return False
    if status.get('role') != role:
        return False
    if role == 'render':
        return bool(status.get('fb_ok') and not status.get('display_error') and hardware_decoder)
    return role == 'control'


def main():
    role=Path('/run/immersive/role').read_text().strip()
    if role not in ('render','control'):raise ValueError('Unknown role')
    sys.path.insert(0,'/opt/immersive/'+('render-node' if role=='render' else 'control-node'))
    import nodeadmin
    password=nodeadmin.admin_password(socket.gethostname())
    authorization=base64.b64encode(('admin:'+password).encode()).decode()
    request=urllib.request.Request('http://127.0.0.1:8080/api/health',headers={'Authorization':'Basic '+authorization})
    with urllib.request.urlopen(request,timeout=2) as response:status=json.load(response)
    decoder=True
    if role=='render':
        import gi
        gi.require_version('Gst','1.0')
        from gi.repository import Gst
        Gst.init(None)
        decoder=Gst.ElementFactory.find('v4l2h264dec') is not None
    if not healthy(role,status,decoder,sys.argv[1] if len(sys.argv)>1 else None):raise RuntimeError('Local role is not healthy or hardware decoder is unavailable')


if __name__=='__main__':
    try:main()
    except Exception as error:
        print(str(error),file=sys.stderr)
        raise SystemExit(1)
